generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ClientStatus {
  active
  archived
}

enum SiteEnvironment {
  production
  staging
  development
}

enum SiteStatus {
  active
  paused
  archived
}

enum InterventionType {
  general_maintenance
  security
  performance
  form
  backup
  deployment
  content
  bugfix
  wpur_plugin_maintenance
  other
}

enum InterventionStatus {
  planned
  in_progress
  done
  issue
  cancelled
}

enum InterventionItemStatus {
  planned
  done
  skipped
  failed
  warning
}

enum BackupType {
  files
  database
  full
  other
}

enum BackupStatus {
  planned
  done
  failed
  unknown
}

enum WatchedFormStatus {
  not_tested
  ok
  issue
  ignored
}

enum SecurityCheckStatus {
  ok
  warning
  issue
  failed
}

enum PerformanceCheckStatus {
  ok
  warning
  issue
  failed
}

model Client {
  id          String       @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  notes       String?
  status      ClientStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sites       Site[]

  @@index([status])
}

model Site {
  id                String             @id @default(cuid())
  clientId          String
  name              String
  url               String
  environment       SiteEnvironment    @default(production)
  status            SiteStatus         @default(active)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interventions     Intervention[]
  wpurImports       WpurImport[]
  backups           BackupRecord[]
  watchedForms      WatchedForm[]
  securityChecks    SecurityCheck[]
  performanceChecks PerformanceCheck[]

  @@index([clientId])
  @@index([status])
}

model Intervention {
  id            String             @id @default(cuid())
  siteId        String
  title         String
  type          InterventionType   @default(other)
  status        InterventionStatus @default(planned)
  date          DateTime
  internalNotes String?
  clientSummary String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  site          Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items         InterventionItem[]
  backups       BackupRecord[]

  @@index([siteId, date])
  @@index([status])
  @@index([type])
}

model InterventionItem {
  id             String                 @id @default(cuid())
  interventionId String
  label          String
  status         InterventionItemStatus @default(planned)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  intervention   Intervention           @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId])
  @@index([status])
}

model WpurImport {
  id          String   @id @default(cuid())
  siteId      String
  periodMonth String
  importedAt  DateTime @default(now())
  payloadJson Json
  summaryJson Json?
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, importedAt])
  @@index([periodMonth])
}

model BackupRecord {
  id              String        @id @default(cuid())
  siteId          String
  interventionId  String?
  type            BackupType    @default(full)
  status          BackupStatus  @default(done)
  performedAt     DateTime
  provider        String?
  storageLocation String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  intervention    Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  @@index([siteId, performedAt])
  @@index([interventionId])
  @@index([status])
  @@index([type])
}

model WatchedForm {
  id                 String            @id @default(cuid())
  siteId             String
  name               String
  pageUrl            String
  expectedRecipients String?
  status             WatchedFormStatus @default(not_tested)
  lastCheckedAt      DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  site               Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([status])
  @@index([lastCheckedAt])
}

model SecurityCheck {
  id                        String              @id @default(cuid())
  siteId                    String
  checkedAt                 DateTime
  status                    SecurityCheckStatus
  httpStatus                Int?
  httpsEnabled              Boolean             @default(false)
  hstsHeader                Boolean             @default(false)
  cspHeader                 Boolean             @default(false)
  xFrameOptionsHeader       Boolean             @default(false)
  xContentTypeOptionsHeader Boolean             @default(false)
  xmlrpcAccessible          Boolean             @default(false)
  readmeAccessible          Boolean             @default(false)
  summary                   String?
  notes                     String?
  rawJson                   Json?
  createdAt                 DateTime            @default(now())
  site                      Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
  @@index([status])
}

model PerformanceCheck {
  id                 String                 @id @default(cuid())
  siteId             String
  checkedAt          DateTime
  status             PerformanceCheckStatus
  httpStatus         Int?
  responseTimeMs     Int?
  contentLengthBytes Int?
  summary            String?
  notes              String?
  rawJson            Json?
  createdAt          DateTime               @default(now())
  site               Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
  @@index([status])
}
