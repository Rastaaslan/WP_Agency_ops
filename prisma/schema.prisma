generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ClientStatus {
  active
  archived
}

enum SiteEnvironment {
  production
  staging
  development
}

enum SiteStatus {
  active
  paused
  archived
}

enum ConnectionType {
  none
  companion_plugin
  application_password
  public_rest
  manual
}

enum ConnectionStatus {
  unknown
  connected
  failed
}

enum ScanStatus {
  pending
  running
  success
  failed
}

enum AssetStatus {
  unknown
  healthy
  update_available
  inactive
  warning
}

enum MaintenanceType {
  update
  backup
  security
  performance
  form
  deployment
  static_publish
  bugfix
  other
}

enum MaintenanceStatus {
  planned
  in_progress
  done
  issue
  cancelled
}

enum InterventionItemStatus {
  done
  skipped
  failed
  warning
}

enum ReportStatus {
  draft
  generated
  archived
}

enum FormEndpointStatus {
  untested
  ok
  issue
  archived
}

enum FormSubmissionStatus {
  received
  flagged
  sent
  failed
}

enum CheckStatus {
  ok
  warning
  issue
  failed
}

enum StaticCompatibilityStatus {
  unknown
  promising
  needs_review
  not_recommended
}

model Client {
  id          String          @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  notes       String?
  status      ClientStatus   @default(active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sites       WordPressSite[]
  reports     Report[]

  @@index([status])
}

model WordPressSite {
  id                String                       @id @default(cuid())
  clientId          String
  name              String
  url               String
  adminUrl          String?
  environment       SiteEnvironment              @default(production)
  status            SiteStatus                   @default(active)
  connectionType    ConnectionType               @default(public_rest)
  connectionStatus  ConnectionStatus             @default(unknown)
  lastScanAt        DateTime?
  notes             String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  client            Client                       @relation(fields: [clientId], references: [id])
  connection        WordPressConnection?
  scans             SiteScan[]
  interventions     MaintenanceIntervention[]
  reports           Report[]
  forms             FormEndpoint[]
  performanceChecks PerformanceCheck[]
  securityChecks    SecurityCheck[]
  staticReviews     StaticCompatibilityReview[]

  @@index([clientId])
  @@index([status])
  @@index([connectionStatus])
}

model WordPressConnection {
  id                    String           @id @default(cuid())
  siteId                String           @unique
  type                  ConnectionType
  apiBaseUrl            String?
  username              String?
  secretReference       String?
  lastConnectionCheckAt DateTime?
  lastConnectionStatus  ConnectionStatus @default(unknown)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  site                  WordPressSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteScan {
  id           String            @id @default(cuid())
  siteId       String
  status       ScanStatus         @default(pending)
  startedAt    DateTime
  finishedAt   DateTime?
  summaryJson  Json?
  rawJson      Json?
  errorMessage String?
  createdAt    DateTime          @default(now())
  site         WordPressSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plugins      WordPressPlugin[]
  themes       WordPressTheme[]

  @@index([siteId, createdAt])
  @@index([status])
}

model WordPressPlugin {
  id              String      @id @default(cuid())
  scanId          String
  name            String
  slug            String?
  version         String?
  updateAvailable Boolean     @default(false)
  newVersion      String?
  active          Boolean     @default(false)
  requiresWp      String?
  requiresPhp     String?
  testedUpTo      String?
  status          AssetStatus @default(unknown)
  scan            SiteScan    @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model WordPressTheme {
  id              String      @id @default(cuid())
  scanId          String
  name            String
  slug            String?
  version         String?
  updateAvailable Boolean     @default(false)
  newVersion      String?
  active          Boolean     @default(false)
  status          AssetStatus @default(unknown)
  scan            SiteScan    @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model MaintenanceIntervention {
  id             String                   @id @default(cuid())
  siteId         String
  title          String
  type           MaintenanceType          @default(other)
  status         MaintenanceStatus        @default(planned)
  description    String?
  technicalNotes String?
  clientSummary  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  site           WordPressSite            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items          InterventionItem[]

  @@index([siteId, createdAt])
  @@index([status])
}

model InterventionItem {
  id             String                  @id @default(cuid())
  interventionId String
  label          String
  status         InterventionItemStatus  @default(done)
  details        String?
  createdAt      DateTime                @default(now())
  intervention   MaintenanceIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId])
}

model Report {
  id              String        @id @default(cuid())
  siteId          String
  clientId        String
  periodStart     DateTime
  periodEnd       DateTime
  title           String
  status          ReportStatus  @default(draft)
  markdownContent String
  htmlContent     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  site            WordPressSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id])

  @@index([siteId, createdAt])
  @@index([clientId])
  @@index([status])
}

model FormEndpoint {
  id                    String             @id @default(cuid())
  siteId                String
  name                  String
  pageUrl               String?
  endpointSlug          String?
  expectedFieldsJson    Json?
  recipientsJson        Json?
  status                FormEndpointStatus @default(untested)
  spamProtectionEnabled Boolean            @default(false)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  site                  WordPressSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  submissions           FormSubmission[]

  @@index([siteId])
  @@index([status])
}

model FormSubmission {
  id             String               @id @default(cuid())
  formEndpointId String
  payloadJson    Json?
  status         FormSubmissionStatus @default(received)
  spamScore      Float?
  createdAt      DateTime             @default(now())
  formEndpoint   FormEndpoint         @relation(fields: [formEndpointId], references: [id], onDelete: Cascade)

  @@index([formEndpointId, createdAt])
}

model PerformanceCheck {
  id             String        @id @default(cuid())
  siteId         String
  url            String
  status         CheckStatus
  httpStatusCode Int?
  responseTimeMs Int?
  pageWeightKb   Int?
  notes          String?
  createdAt      DateTime      @default(now())
  site           WordPressSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([status])
}

model SecurityCheck {
  id                       String        @id @default(cuid())
  siteId                   String
  status                   CheckStatus
  httpsEnabled             Boolean
  hasSecurityHeaders       Boolean
  hstsEnabled              Boolean       @default(false)
  contentSecurityPolicy    Boolean       @default(false)
  xFrameOptions            Boolean       @default(false)
  xContentTypeOptions      Boolean       @default(false)
  xmlrpcExposed            Boolean?
  readmeExposed            Boolean?
  directoryListingDetected Boolean?
  notes                    String?
  createdAt                DateTime      @default(now())
  site                     WordPressSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([status])
}

model StaticCompatibilityReview {
  id                 String                    @id @default(cuid())
  siteId             String
  status             StaticCompatibilityStatus @default(unknown)
  score              Int?
  isBrochureSite     Boolean                   @default(false)
  noDynamicCommerce  Boolean                   @default(false)
  noMemberArea       Boolean                   @default(false)
  formsIdentified    Boolean                   @default(false)
  searchIdentified   Boolean                   @default(false)
  commentsIdentified Boolean                   @default(false)
  recommendations    String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  site               WordPressSite             @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}
